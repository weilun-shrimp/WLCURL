{
    "name": "weilun/wlcurl",
    "description": "Make PHP API (cURL) requests easier, clearer, and more modular. Everything is open source on my GitHub—just take it and use it well.",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "authors": [
        {
            "name": "WeiLun",
            "email": "gxh0181160809rp@gmail.com"
        }
    ],
    "homepage": "https://github.com/weilun-shrimp/WLCURL",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "WeiLun\\WLCURL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeiLun\\WLCURL\\": "src/",
            "Weilun\\WLCURL\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "11.3"
    }
}
